{
  "name": "noteit-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:pinned && tsc -b && vite build && npm run check:manifest",
    "lint": "eslint . && node scripts/lint-baseline.ts",
    "lint:baseline:update": "node scripts/lint-baseline.ts --update",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.tests.json",
    "test:lint-rules": "node scripts/test-lint-rules.ts",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:module-boundary": "node scripts/check-highlight-untouched.ts",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test --project e2e --project two-device",
    "test:corpus": "playwright test --project corpus",
    "test:perf": "node scripts/run-perf.ts",
    "test:spike": "node scripts/run-spike.ts",
    "scan:dist": "node scripts/scan-dist.ts",
    "release:m1-checklist": "node scripts/release-m1-checklist.ts",
    "release:m2-checklist": "node scripts/release-m2-checklist.ts",
    "release:m3-checklist": "node scripts/release-m3-checklist.ts",
    "env:local": "node scripts/write-local-env.ts",
    "verify": "node scripts/verify.ts",
    "baseline:update": "CORPUS_UPDATE_BASELINE=1 playwright test --project corpus && PERF_UPDATE_BASELINE=1 playwright test --project perf && node scripts/scan-dist.ts --update-baseline",
    "db:start": "supabase start --workdir ..",
    "db:stop": "supabase stop --workdir ..",
    "db:reset": "supabase db reset --workdir ..",
    "preview": "vite preview",
    "check:pinned": "node scripts/check-pinned.ts",
    "check:manifest": "node scripts/check-manifest-version.ts"
  },
  "dependencies": {
    "@crxjs/vite-plugin": "3.0.0",
    "@supabase/supabase-js": "2.118.0",
    "dexie": "4.4.6",
    "mark.js": "8.11.1",
    "preact": "10.29.8",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/chrome": "0.1.32",
    "@types/mark.js": "8.11.12",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "fake-indexeddb": "6.2.6",
    "globals": "16.5.0",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
